# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Where downloaded files are staged before being sent to the client
DOWNLOAD_DIR=./tmp_downloads

# Safety cap: refuse to resolve/download media longer than this (seconds)
MAX_DURATION_SECONDS=10800

# How old a leftover job folder must be (minutes) before the cleanup task removes it
MAX_FILE_AGE_MINUTES=30

PORT=8000
